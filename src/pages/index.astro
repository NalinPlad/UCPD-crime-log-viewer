---
import 'leaflet/dist/leaflet.css';
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <style is:global>
    #main { flex: 1; display: flex; min-height: 0; }
    aside { position: absolute; top: 10px; right: 10px; bottom: 10px; z-index: 600; width: 300px; display: flex; flex-direction: column; overflow: hidden; background: #0e0f11ee; border: 1px solid #2a2d32; border-radius: 6px; box-shadow: 0 8px 28px #0009; backdrop-filter: blur(6px); }
    #count { padding: 10px 14px; color: var(--muted); border-bottom: 1px solid var(--line); }
    #list { flex: 1; overflow-y: auto; }
    #list div { display: grid; grid-template-columns: 8px 1fr; gap: 0 10px; padding: 9px 14px; border-bottom: 1px solid var(--line); cursor: pointer; }
    #list div:hover { background: #16181b; }
    #list i { width: 8px; height: 8px; border-radius: 50%; margin-top: 4px; }
    #list b { font-weight: 500; font-size: 13px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    #list span { grid-column: 2; color: var(--muted); }
    #list .nomap i { background: none !important; box-shadow: inset 0 0 0 1px var(--muted); }
    #all { display: block; margin: 10px; flex: none; padding: 9px; text-align: center; border: 1px solid #2a2d32; border-radius: 4px; color: var(--fg); text-decoration: none; }
    #all:hover { background: #16181b; }
    #mapwrap { flex: 1; position: relative; }
    #map { position: absolute; inset: 0; background: var(--bg); }
    #range { position: absolute; left: 10px; top: 10px; z-index: 500; padding: 4px 8px; border-radius: 4px; background: #0e0f11cc; pointer-events: none; font-variant-numeric: tabular-nums; }
    #tl { position: relative; height: 72px; flex: none; user-select: none; touch-action: none; border-top: 1px solid var(--line); }
    #tl canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
    #band { position: absolute; top: 8px; bottom: 22px; background: color-mix(in srgb, var(--band) 22%, transparent); border: 1px solid var(--band); border-radius: 3px; cursor: grab; }
    #band:active { cursor: grabbing; }
    #handle { position: absolute; left: -5px; top: -1px; bottom: -1px; width: 10px; cursor: ew-resize; }
    #handle::after { content: ''; position: absolute; left: 3px; top: 30%; bottom: 30%; width: 4px; border-radius: 2px; background: var(--band); }
    .leaflet-tooltip.tip { background: #17191c; color: var(--fg); border: 1px solid #2a2d32; border-radius: 4px; box-shadow: 0 6px 24px #0008; padding: 12px 14px; width: 306px; max-width: 90vw; white-space: normal; font-size: 12.75px; line-height: 1.5; }
    .leaflet-tooltip.tip::before { display: none; }
    .tip b { display: block; margin-bottom: 5px; font-size: 14.5px; line-height: 1.3; }
    .tip span { color: var(--muted); }
    .leaflet-interactive { cursor: pointer; }
    .leaflet-container:focus, .leaflet-interactive:focus { outline: none; }
    .leaflet-control-attribution { background: #0e0f11aa !important; color: var(--muted) !important; }
    .leaflet-control-attribution a { color: var(--muted) !important; }
    @media (max-width: 640px) { aside { display: none; } }
  </style>
  <div id="main">
    <div id="mapwrap">
      <div id="map"></div>
      <div id="range"></div>
      <aside>
        <div id="count"></div>
        <div id="list"></div>
        <a id="all" href={`${import.meta.env.BASE_URL}table`}>All incidents</a>
      </aside>
    </div>
  </div>
  <div id="tl">
    <canvas></canvas>
    <div id="band"><div id="handle"></div></div>
  </div>
  <script src="../scripts/app.js"></script>
</Layout>
